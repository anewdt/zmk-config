#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Colemak";
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  F  |  P  |  G  |   |  J  |  L   |  U  |  Y  |  ;  |  DEL  |
// | BKSP |  A  |  R  |  S  |  T  |  D  |   |  H  |  N   |  E  |  I  |  O  |   '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  K  |  M   |  ,  |  .  |  /  | SHFT  |
//                    | CTRL | LWR | ENT |   | SPC | RSE  | WIN |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp F &kp P &kp G   &kp J &kp L  &kp U     &kp Y   &kp SEMI &kp DEL
   &kp BSPC  &kp A &kp R &kp S &kp T &kp D   &kp H &kp N  &kp E     &kp I   &kp O    &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp K &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                  &kp LCTRL &mo 2 &kp RET      &kp SPACE &mo 3 &kp LGUI
                        >;
                };

                qwerty_layer {
                        display-name = "Qwerty";
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |  DEL  |
// | BKSP |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |   '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | SHFT  |
//                    | CTRL | LWR | ENT |   | SPC | RSE  | WIN |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp DEL
   &kp BSPC  &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                  &kp LCTRL &mo 2 &kp RET      &kp SPACE &mo 3 &kp LGUI
                        >;
                };

                lower_layer {
                        display-name = "Lower Layer";
// -----------------------------------------------------------------------------------------
// |  ESC |        !        |  @  |  #  |  $  |  %   |   |  ^  |  &  |  *  |  (  |  )  | HOME |
// |      |        1        |  2  |  3  |  4  |  5   |   |  6  |  7  |  8  |  9  |  0  |   ~  |
// | CAPS | WIN(SHFT(LEFT)) |  {  |  [  |  (  | NMPD |   |     |  )  |  ]  |  }  |     |  ALT |
//                               |     |     | ENT |      | SPC |  CLMK  | QWERTY |
                        bindings = <
   &kp ESC   &kp EXCL          &kp AT    &kp HASH  &kp DLLR  &kp PRCNT     &kp CARET  &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR  &kp HOME
   &trans    &kp N1            &kp N2    &kp N3    &kp N4    &kp N5        &kp N6     &kp N7    &kp N8    &kp N9    &kp N0    &kp TILDE
   &kp CLCK  &kp LG(LS(LEFT))  &kp LBRC  &kp LBKT  &kp LPAR  &mo 5         &trans     &kp RPAR  &kp RBKT  &kp RBRC  &trans    &kp RALT
                                         &trans  &trans  &kp RET             &kp SPACE  &to 0   &to 1
                        >;
                };

                raise_layer {
                        display-name = "Raise Layer";
// ----------------------------------------------------------------------------
// |     |     |     |  UP |  RW |  FF |   | MUTE | VOLDWN |  VOLUP |  PP |     |  \  |
// |  \  |  `  | LFT | DWN | RGT |  ~  |   |      |    -   |   +    |  =  |  _  | '|' |
// |  F1 | F2  | F3  | F4  | F5  |  F6 |   |  F7  |   F8   |   F9   | F10 | F11 | F12 |
//                    |    | ADJ | ENT |   | SPC |     |     |
                        bindings = <
   &trans   &trans    &trans    &kp UP    &kp C_RW  &kp C_FF      &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_PP  &trans    &kp BSLH
   &kp BSLH &kp GRAVE &kp LEFT  &kp DOWN  &kp RIGHT &kp TILDE     &trans     &kp MINUS    &kp PLUS     &kp EQUAL &kp UNDER &kp PIPE
   &kp F1   &kp F2    &kp F3    &kp F4    &kp F5    &kp F6        &kp F7     &kp F8       &kp F9       &kp F10   &kp F11   &kp F12
                                 &trans  &mo 4   &kp RET            &kp SPACE   &trans    &trans
                        >;
                };

                adjust_layer {
                    display-name = "Adjust Layer";
// -----------------------------------------------------------------------------------------
// | BT1 | BT2 | BT3 | BT4 |  BT5 | BT CLR |   |    |     |     | RESET | BTLDR |     |
// |     |     |     |     |      |        |   |    |     |     |       |       |     |
// |     |     |     |     |      |        |   |    |     |     |       |       |     |
//                      |     |    |     |       |     |     |     |
                        bindings = <
   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR   &none &none &none &sys_reset &bootloader &none
   &none         &none         &none         &none         &none         &none        &none &none &none &none      &none       &none
   &none         &none         &none         &none         &none         &none        &none &none &none &none      &none       &none
                                                &trans      &trans     &trans           &trans    &trans    &trans
                        >;
                };

                numpad_layer {
                    display-name = "Numpad";
// ----------------------------------------------------------------------------
// |     |     |     |     |     |     |   |      |   7  |   8  |  9  |     |     |
// |     |     |     |     |     |     |   |      |   4  |   5  |  6  |     |     |
// |     |     |     |     |     |     |   |      |   1  |   2  |  3  |     |     |
//                        |     |     |     |       |    |  0  |     |
                        bindings = <
   &trans   &trans   &trans   &trans   &trans   &trans      &trans   &kp N7   &kp N8   &kp N9   &none   &none
   &trans   &trans   &trans   &trans   &trans   &trans      &trans   &kp N4   &kp N5   &kp N6   &none   &none
   &trans   &trans   &trans   &trans   &trans   &trans      &trans   &kp N1   &kp N2   &kp N3   &none   &none
                          &trans   &trans    &trans           &trans   &kp N0  &trans
                        >;
                };
        };
};
